				}
			}

			@media (prefers-color-scheme: dark) {
				body {
					background-color: var(--bg-black);
					color: var(--secondary);
				}
			} */

			.cat-separator {
				animation: animarSrc 1s steps(1) infinite;
			}

			/* @keyframes animarSrc {
				0% {
					content: url('separator-1.png');
				}
