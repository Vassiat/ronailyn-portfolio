		<style>
			:root {
				/* Color palette */
				--primary: #722549;
				--secondary: #ddccee;
				--accent-purple: #6c567c;
				--accent-dark: #221a32;
				--bg-black: #0e0204;
				--accent-sand: #d4b7a7;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
				border: 0 solid;
				outline: 0 solid;
			}

			body {
				background-color: var(--secondary);
				color: var(--accent-dark);
			}

			/* Until uses theme change */
			/* @media (prefers-color-scheme: light) {
