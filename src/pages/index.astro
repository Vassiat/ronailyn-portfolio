---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Ronailyn Portfolio</title>
		<meta name="description" content="Welcome to Artist Ronailyn's Portfolio!">
		<meta name="keywords" content="artist, design, creative">
		<meta name="new_keywords" content="artist, design, creative">
		<meta property="og:locale" content="en_US">
		<meta property="og:title" content="Ronailyn Portfolio">
		<meta property="og:url" content="https://ronailyn.pages.dev">
		<meta property="og:site_name" content="Ronailyn Portfolio">
		<meta property="og:type" content="website">
		<meta property="og:description" content="Explore the paintings, illustrations, and digital art by Ronailyn!">
		<meta property="og:image" content="https://ronailyn.pages.dev/logo.png">
		<meta property="og:image:width" content="894">
		<meta property="og:image:height" content="502">
		<meta property="og:image:type" content="image/png">
		<meta property="twitter:title" content="Ronailyn Portfolio">
		<meta property="twitter:card" content="summary_large_image">
		<meta property="twitter:description" content="Explore the paintings, illustrations, and digital art by Ronailyn!">
		<meta property="twitter:image" content="https://ronailyn.pages.dev/logo.png">
		<meta property="twitter:url" content="https://ronailyn.pages.dev">
		<meta name="author" content="Ronailyn Tablante">
		<meta name="copyright" content="© 2026 Ronailyn Tablante. All rights reserved.">
		<link rel="shortcut icon" sizes="24x24" href="/favicon.ico">
		<link id="dynamic-favicon" rel="icon" sizes="24x24" href="/favicon-1.png" type="image/png" />
		<meta name="theme-color" content="#ddccee" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#221a32" media="(prefers-color-scheme: dark)">
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href="https://ronailyn.pages.dev">
		<meta name="viewport" content="width=device-width" />
		<link rel="manifest" href="/site.webmanifest">
		<meta name="msapplication-TileColor" content="#6c567c">
		<style is:global>
			*, *:after, *:before {
				cursor: url("/cursor.svg") 5 8, auto;
			}
		</style>
		<style>
			:root {
				/* Color palette */
				--primary: #722549;
				--secondary: #ddccee;
				--secondary-70: #ddcceecb;
				--accent-purple: #6c567c;
				--accent-dark: #221a32;
				--bg-black: #0e0204;
				--accent-sand: #d4b7a7;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
				border: 0 solid;
				outline: 0 solid;
			}

			body {
				background-color: #d4b7a770;
				color: var(--accent-dark);
			}

			.colorPalette {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 10px;
				background-color: white;
				padding: 1rem;
				margin: 2.8rem 0;
			}

			.colorPalette > div {
				padding: 2rem 2rem;
				border-top-left-radius: 1.7rem;
				border-top-right-radius: 1.7rem;
				mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0) 90%);
			}

			/* Until uses theme change */
			/* @media (prefers-color-scheme: light) {
				body {
					background-color: var(--secondary);
					color: var(--accent-dark);
				}
			}

			@media (prefers-color-scheme: dark) {
				body {
					background-color: var(--bg-black);
					color: var(--secondary);
				}
			} */

			.principal-nekita-logo {
				width: 6ch;
				aspect-ratio: 16/9;
				position: relative;
				overflow: hidden;
				font-size: 4rem;
			}

			.principal-nekita-logo img {
				position: absolute;
				width: 130%;
				height: 130%;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				object-fit: contain;
			}

			.title-hero {
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			*[data-typewriter-words] {
				display: inline-flex;
				flex-direction: column;
				position: relative;
				overflow: hidden;
				font-size: 1em;
			}

			.cat-separator {
				width: 100%;
				position: relative;
				left: 0;
				/* bottom: 99%; */
				translate: 0 31.4%;
				z-index: 1;
			}

			#tail-svg {
				position: relative;
				width: 50%;
				translate: 100% 60%;
				z-index: 10;
			}

			#tail-svg > svg {
				position: absolute;
				right: 0;
				width: 50%;
			}
		</style>
		<script src="@scripts/favicon.ts" />
		<script src="@scripts/tails.ts" />
		<script src="@scripts/cursor.ts" />
		<script src="@scripts/typewriter.ts" />
	</head>
	<body>
		<section style="min-height: 1700px;  position: relative;">
			<h1 class="title-hero">
				<div class="principal-nekita-logo">
					<img alt="Nekita logo" src="/logo.png" />
				</div>
				<span>Venezuelan <stroke data-typewriter-words="Artist,Illustrator,Designer" data-typewriter-type="float"></stroke></span>
				<stroke data-typewriter-words="Artist,Illustrator,Designer" data-typewriter-type="float2"></stroke>
				<stroke data-typewriter-words="Artist,Illustrator,Designer" data-typewriter-type="stair"></stroke>
				<stroke data-typewriter-words="Artist,Illustrator,Designer" data-typewriter-type="bubble"></stroke>
			</h1>
		</section>

		<div id="tail-svg"></div>
		<div class="cat-separator" ondragstart="return false;" onselectstart="return false;" draggable="false">
			<img
				alt="Back black cat illustration"
				src="/black-cat/back.png"
				style="width: 100%; position: relative; mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 70%, rgba(0,0,0,0) 95%); user-select: none; pointer-events: none; user-drag: none; z-index: -1 !important;"
				/>
		</div>
		<section class="remove-drag-img" style="min-height: 80vh; position: relative; color: var(--accent-sand); padding-top: 4rem; background-color: #110407;">

			<main style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
				<h2 style="text-align: center; font-size: 2rem;">
					Title
				</h2>
	
				<p style="padding: 0 0.3rem; opacity: 0.65; text-wrap: pretty;">
					Lorem, ipsum dolor sit amet consectetur adipisicing elit. Similique voluptate possimus alias inventore tempore exercitationem vel dolorum, tempora omnis pariatur nihil quasi earum quod, dignissimos totam quos error? Illum, quibusdam.
					
					<br />
					<br />
					Lorem ipsum dolor sit amet consectetur adipisicing elit. Praesentium minima earum officia animi officiis tempora odit, quisquam, excepturi beatae, sunt ea culpa! Molestiae quia saepe iusto et distinctio facere quidem?
				</p>
			</main>
		</section>
		<script is:inline>
			const section = document.querySelector(".remove-drag-img");

			
			section?.addEventListener('dragstart', (e) => {
				const seleccion = window.getSelection();
	
				if (seleccion && e.dataTransfer?.setDragImage) {
					const textClone = document.createElement('div');
					textClone.innerText = seleccion.toString();
					
					textClone.style.position = 'absolute';
					textClone.style.top = '-9999px';
					textClone.style.padding = '5px 10px';
					textClone.style.borderRadius = '4px';
					textClone.style.fontFamily = 'sans-serif';
					
					document.body.appendChild(textClone);
					
					e.dataTransfer.setDragImage(textClone, 0, 0);
					
					setTimeout(() => {
						document.body.removeChild(textClone);
					}, 0);
				}
			})
		</script>

		<section class="colorPalette">
			<h1 style="flex: 1 0 100%; text-align: center;">Color palette</h1>
			<div style="background-color: var(--primary);"></div>
			<div style="background-color: var(--secondary);"></div>
			<div style="background-color: var(--accent-purple);"></div>
			<div style="background-color: var(--accent-dark);"></div>
			<div style="background-color: var(--bg-black);"></div>
			<div style="background-color: var(--accent-sand);"></div>
		</section>
	</body>
</html>
